{
  "name": "mobile_app_caps",
  "version": "1.0.0",
  "private": true,
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:clear": "expo start --web --clear",
    "web:open": "start http://localhost:8081/",
    "typecheck": "tsc --noEmit",
    "audit:fix": "npm audit fix || exit 0",
    "repo:init": "git init && git checkout -b main && git add . && git commit -m \"Init capstone app\" && git remote add origin https://github.com/aasvrn/mobile_app_caps.git",
    "repo:push": "git push -u origin main",
    "submission": "node tools/prepare-submission.js",
    "export:web": "expo export --platform web --output-dir dist --clear",
    "deploy:gh": "gh-pages -d dist -b gh-pages",
    "deploy": "npm run export:web && npm run deploy:gh",
    "tunnel:web": "lt --port 8081",
    "serve:dist": "http-server ./dist -p 8082"
  },
  "dependencies": {
    "expo": "^51.0.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-dom": "18.2.0",
    "react-native-web": "0.19.10",
    "@expo/metro-runtime": "3.2.3",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.12",
    "@react-navigation/stack": "^6.3.20",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-native-async-storage/async-storage": "1.23.1",
    "react-native-gesture-handler": "^2.20.0",
    "react-native-safe-area-context": "^4.10.5",
    "@expo/vector-icons": "^14.0.2"
  },
  "devDependencies": {
    "typescript": "~5.3.3",
    "@types/react": "~18.2.79",
    "@types/react-native": "^0.73.0",
    "gh-pages": "^6.0.0",
    "localtunnel": "^2.0.2",
    "http-server": "^14.1.1"
  }
}